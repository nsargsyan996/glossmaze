# Copy the values into EAS (expo.dev → project → Environment variables, "production" environment),
# or `eas env:create`. Leave them empty for development: Google's test IDs and test ads are used.

# AdMob app IDs (AdMob → Apps → App settings). Format: ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# Interstitial ad unit IDs (AdMob → Apps → Ad units). Format: ca-app-pub-XXXXXXXXXXXXXXXX/ZZZZZZZZZZ
# Only read in production builds; every other build uses Google's test unit.
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
